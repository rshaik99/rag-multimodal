# ---------- secrets ----------
.env

# ---------- python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- runtime data (regenerable) ----------
# Sample docs are (re)generated by make_sample_docs.py; real corpora belong
# here at runtime but shouldn't be committed.
data/*
!data/.gitkeep

# Step A output cache -- regenerated by step_a_ingest.
storage/*
!storage/.gitkeep

# Extracted figures + VLM descriptions -- regenerated by ingest_images.py.
assets/*
!assets/.gitkeep

# Qdrant's on-disk volume from docker-compose.yml.
qdrant_storage/

# ---------- editor / tooling ----------
.vscode/*
!.vscode/launch.json
.claude/settings.local.json
*.log
