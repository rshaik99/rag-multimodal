# ---- required ----
OPENAI_API_KEY=sk-...

# ---- optional ----
# python-dotenv does not strip inline "# comment" text on an empty-value line --
# it becomes part of the value. Keep comments on their own line above the key.
# COHERE_API_KEY: enables API reranking (rerank-v4.0-fast). Falls back to local BGE or no-op.
COHERE_API_KEY=
# LLAMA_CLOUD_API_KEY: enables LlamaParse (API v2). Falls back to PyMuPDF4LLM.
LLAMA_CLOUD_API_KEY=
# ANTHROPIC_API_KEY: Phase 2 vision synthesis with claude-sonnet-5
ANTHROPIC_API_KEY=

# ---- infra ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_lab

# ---- tracing (highly recommended, turn on in minute 1) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-lab
